        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "taskId", "taskCode", "charterId", "milestoneId", "oldEnd", "proposedEnd",
        "reason", "impactOnMilestone", "requestedBy", "approverA", "decisionA", "decisionEd",
        "decision", "isDemo", "createdAt", "updatedAt"
      ]
    },
    "ReviewMeeting": {
      "title": "ReviewMeeting",
      "description": "Monthly/Quarterly/Half-Year/Yearly BSC review, Steering Committee, and Departmental Follow-up meeting with minutes, decisions, calendar sync, and auto-converted action items.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "meetingCode": { "type": "string", "maxLength": 32 },
        "projectId": { "type": "string", "maxLength": 128 },
        "charterId": { "type": "string", "maxLength": 128 },
        "perspective": {
          "type": "string",
          "enum": ["Financial", "Customer", "Internal Business Processes", "Learning & Growth", "ESG"]
        },
        "type": {
          "type": "string",
          "enum": [
            "Monthly Project Review",
            "Quarterly BSC Review",
            "Half-Year BP Review",
            "Half-Year Business Plan Review",
            "Yearly Review",
            "Yearly BSC Review",
            "Project Steering Committee",
            "Departmental Follow-up Meeting"
          ]
        },
        "title": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "venue": { "type": "string", "maxLength": 300 },
        "chairperson": { "type": "string", "maxLength": 120 },
        "attendees": { "type": "array", "description": "Up to 30 attendee names" },
        "agenda": { "type": "string", "maxLength": 2000 },
        "minutes": { "type": "string", "maxLength": 4000 },
        "decisions": { "type": "string", "maxLength": 2000 },
        "actionItems": { "type": "array", "description": "Up to 40 action item objects linked to tasks" },
        "googleEventId": { "type": "string", "maxLength": 200 },
        "syncStatus": { "type": "string", "enum": ["not_synced", "synced", "pending", "error"] },
        "lastSyncedAt": { "type": "string", "maxLength": 40 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "type", "title", "date", "minutes", "decisions", "isDemo", "createdAt", "updatedAt"
      ]
    },
    "CalendarSyncLog": {
      "title": "CalendarSyncLog",
      "description": "Append-only audit log of Google Calendar synchronization operations and errors.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entityType": { "type": "string", "enum": ["task", "bscTask", "meeting", "reviewMeeting", "calendar"] },
        "entityId": { "type": "string", "maxLength": 128 },
        "entityCode": { "type": "string", "maxLength": 48 },
        "googleEventId": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "enum": ["create", "update", "cancel", "pull", "error"] },
        "status": { "type": "string", "enum": ["success", "error"] },
        "message": { "type": "string", "maxLength": 500 },
        "actorName": { "type": "string", "maxLength": 120 },
        "syncedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "entityType", "entityId", "entityCode", "action",
        "status", "message", "actorName", "syncedAt", "createdAt"
      ]
    },
    "BscGovernanceConfig": {
      "title": "BscGovernanceConfig",
      "description": "Admin-configurable escalation thresholds, reminder schedules, daily digest time, and notification channel toggles.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reminderDaysBeforeDue": { "type": "number" },
        "escalationL1Days": { "type": "number" },
        "escalationL2Days": { "type": "number" },
        "escalationL3Days": { "type": "number" },
        "escalationL4Days": { "type": "number" },
        "blockedEscalationDays": { "type": "number" },
        "followUpComplianceTarget": { "type": "number" },
        "dailyDigestTime": { "type": "string", "maxLength": 10 },
        "dailyDigestTimezone": { "type": "string", "maxLength": 50 },
        "channels": { "type": "object", "description": "Map of channel toggles: inApp, email, whatsapp, sms" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "reminderDaysBeforeDue", "escalationL1Days", "escalationL2Days",
        "escalationL3Days", "escalationL4Days", "blockedEscalationDays",
        "followUpComplianceTarget", "dailyDigestTime", "dailyDigestTimezone", "channels", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile, role, and private preference settings isolated to owner or Super Admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Explicit Super Admin registry."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Strategic projects owned by the authenticated user."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Project tasks and subtasks linked to a verified parent project."
    },
    "/tasks/{taskId}/activity/{activityId}": {
      "schema": { "$ref": "#/entities/TaskActivity" },
      "description": "Task comments and audit log entries guarded by parent task Master Gate."
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Project governance meetings linked to a verified parent project."
    },
    "/raciEntries/{entryId}": {
      "schema": { "$ref": "#/entities/RaciEntry" },
      "description": "Project RACI responsibility matrix entries linked to a verified parent project."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Organization directory entries isolated to the owning workspace or Super Admin."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications and reminders isolated to the owning user."
    },
    "/bscKras/{kraId}": {
      "schema": { "$ref": "#/entities/BscKra" },
      "description": "Master BSC Perspectives, Strategic Objectives, and KRAs."
    },
    "/projectCharters/{charterId}": {
      "schema": { "$ref": "#/entities/ProjectCharter" },
      "description": "8-section Turag BSC Project Charters with milestones and activities."
    },
    "/bscTasks/{taskId}": {
      "schema": { "$ref": "#/entities/BscTask" },
      "description": "Governed BSC tasks linked to an approved parent Project Charter."
    },
    "/bscFollowUps/{followUpId}": {
      "schema": { "$ref": "#/entities/TaskFollowUp" },
      "description": "Append-only follow-up audit log entries linked to a verified BSC task."
    },
    "/dateChangeRequests/{requestId}": {
      "schema": { "$ref": "#/entities/DateChangeRequest" },
      "description": "Date-change approval requests linked to a verified BSC task."
    },
    "/reviewMeetings/{meetingId}": {
      "schema": { "$ref": "#/entities/ReviewMeeting" },
      "description": "Monthly, Quarterly, Half-Year, and Yearly BSC review meetings."
    },
    "/bscGovernanceConfig/{configId}": {
      "schema": { "$ref": "#/entities/BscGovernanceConfig" },
      "description": "Admin-configurable escalation and reminder thresholds per workspace."
    },
    "/calendarSyncLogs/{logId}": {
      "schema": { "$ref": "#/entities/CalendarSyncLog" },
      "description": "Append-only Google Calendar synchronization and error audit logs."
    }
  }
}
