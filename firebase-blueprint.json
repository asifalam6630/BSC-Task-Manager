{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account profile, role-based access settings, and notification preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": {
          "type": "string",
          "enum": [
            "Super Admin",
            "MD / Executive",
            "ED / Project Sponsor",
            "Project Manager",
            "Department Head",
            "Team Member",
            "Viewer"
          ]
        },
        "department": { "type": "string", "maxLength": 100 },
        "designation": { "type": "string", "maxLength": 100 },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "reminderDays": { "type": "array", "description": "Days before due date to remind (max 4 items)" },
        "emailAlerts": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "department", "designation", "theme", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Explicit admin registry document granting Super Admin privileges.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Strategic project record with BSC alignment, schedule, milestones, budget, and color code.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectCode": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 180 },
        "category": { "type": "string", "maxLength": 100 },
        "strategicObjective": { "type": "string", "maxLength": 400 },
        "description": { "type": "string", "maxLength": 2000 },
        "projectOwner": { "type": "string", "maxLength": 120 },
        "projectChampion": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 100 },
        "startDate": { "type": "string", "maxLength": 20 },
        "targetDate": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "status": {
          "type": "string",
          "enum": ["Not Started", "Planning", "In Progress", "At Risk", "Delayed", "On Hold", "Completed", "Cancelled"]
        },
        "budget": { "type": "number" },
        "color": { "type": "string", "maxLength": 20 },
        "milestones": { "type": "array", "description": "Up to 25 milestone objects" },
        "documents": { "type": "array", "description": "Up to 25 document metadata references" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "projectCode", "name", "category", "strategicObjective", "description",
        "projectOwner", "projectChampion", "department", "startDate", "targetDate",
        "priority", "status", "color", "isDemo", "createdAt", "updatedAt"
      ]
    },
    "Task": {
      "title": "Task",
      "description": "Project task or subtask with RACI assignees, weighted completion, dependencies, and Google Calendar sync metadata.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "taskCode": { "type": "string", "maxLength": 32 },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectCode": { "type": "string", "maxLength": 32 },
        "parentTaskId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "responsible": { "type": "string", "maxLength": 120 },
        "accountable": { "type": "string", "maxLength": 120 },
        "consulted": { "type": "array", "description": "Up to 10 consulted names" },
        "informed": { "type": "array", "description": "Up to 10 informed names" },
        "department": { "type": "string", "maxLength": 100 },
        "plannedStart": { "type": "string", "maxLength": 20 },
        "plannedEnd": { "type": "string", "maxLength": 20 },
        "actualStart": { "type": "string", "maxLength": 20 },
        "actualEnd": { "type": "string", "maxLength": 20 },
        "estimatedDays": { "type": "number" },
        "weight": { "type": "number" },
        "priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "status": {
          "type": "string",
          "enum": ["Not Started", "In Progress", "Pending Approval", "Under Review", "Completed", "Delayed", "On Hold"]
        },
        "progress": { "type": "number" },
        "dependencies": { "type": "array", "description": "Up to 10 task IDs" },
        "remarks": { "type": "string", "maxLength": 1000 },
        "attachments": { "type": "array", "description": "Up to 10 attachment names or URLs" },
        "googleEventId": { "type": "string", "maxLength": 200 },
        "syncStatus": { "type": "string", "enum": ["not_synced", "synced", "pending", "error"] },
        "lastSyncedAt": { "type": "string", "maxLength": 40 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "taskCode", "projectId", "projectCode", "name", "description",
        "responsible", "accountable", "department", "plannedStart", "plannedEnd",
        "estimatedDays", "weight", "priority", "status", "progress", "syncStatus",
        "isDemo", "createdAt", "updatedAt"
      ]
    },
    "TaskActivity": {
      "title": "TaskActivity",
      "description": "Task comment or audit trail event stored under a task.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "enum": ["comment", "status_change", "progress_update", "sync"] },
        "message": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "authorName", "type", "message", "createdAt"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Project governance meeting with agenda, minutes, action points, and Google Calendar sync metadata.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "meetingCode": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 200 },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectCode": { "type": "string", "maxLength": 32 },
        "category": {
          "type": "string",
          "enum": [
            "BOD Meeting",
            "Steering Committee Meeting",
            "Project Review Meeting",
            "Departmental Meeting",
            "Progress Review Meeting",
            "Follow-up Meeting",
            "Monthly Project Review",
            "Quarterly BSC Review",
            "Half-Year Business Plan Review",
            "Yearly BSC Review",
            "Project Steering Committee",
            "Departmental Follow-up Meeting"
          ]
        },
        "date": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "venue": { "type": "string", "maxLength": 300 },
        "chairperson": { "type": "string", "maxLength": 120 },
        "participants": { "type": "array", "description": "Up to 25 participant names" },
        "agenda": { "type": "string", "maxLength": 2000 },
        "minutes": { "type": "string", "maxLength": 4000 },
        "actionPoints": { "type": "array", "description": "Up to 30 action point objects" },
        "googleEventId": { "type": "string", "maxLength": 200 },
        "syncStatus": { "type": "string", "enum": ["not_synced", "synced", "pending", "error"] },
        "lastSyncedAt": { "type": "string", "maxLength": 40 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "meetingCode", "title", "projectId", "projectCode", "category",
        "date", "startTime", "endTime", "venue", "chairperson", "agenda", "minutes",
        "syncStatus", "isDemo", "createdAt", "updatedAt"
      ]
    },
    "RaciEntry": {
      "title": "RaciEntry",
      "description": "Spreadsheet-style RACI responsibility matrix row mapped to a project.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
