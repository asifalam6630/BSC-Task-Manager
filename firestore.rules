        bscTaskBelongsToCaller(incoming().taskId);

      allow update: if isVerified() &&
        isValidId(requestId) &&
        isValidDateChangeRequest(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().taskId == existing().taskId &&
        incoming().oldEnd == existing().oldEnd &&
        incoming().proposedEnd == existing().proposedEnd &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          ((isOwner(existing().ownerId) || isAdmin()) &&
            existing().decision == 'Pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'decisionA', 'decisionEd', 'decision', 'decisionDate', 'comment', 'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'decisionA', 'decisionEd', 'decision', 'decisionDate', 'comment', 'updatedAt'
            ]))
        );

      allow delete: if isVerified() && isValidId(requestId) && (isOwner(existing().ownerId) || isAdmin());
    }

    // =========================================================================
    // /reviewMeetings/{meetingId} — Unified BSC Review & Steering Meetings
    // =========================================================================
    match /reviewMeetings/{meetingId} {
      allow get: if isValidId(meetingId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerified() &&
        isValidId(meetingId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().keys().hasAll([
          'ownerId', 'type', 'title', 'date', 'minutes', 'decisions', 'isDemo', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'ownerId', 'meetingCode', 'projectId', 'charterId', 'perspective', 'type', 'title',
          'date', 'startTime', 'endTime', 'venue', 'chairperson', 'attendees', 'agenda',
          'minutes', 'decisions', 'actionItems', 'googleEventId', 'syncStatus', 'lastSyncedAt',
          'isDemo', 'createdAt', 'updatedAt'
        ]) &&
        isValidReviewMeeting(incoming());

      allow update: if isVerified() &&
        isValidId(meetingId) &&
        isValidReviewMeeting(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(existing().ownerId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'googleEventId', 'syncStatus', 'lastSyncedAt', 'updatedAt'
            ])) ||
          ((isOwner(existing().ownerId) || isAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'meetingCode', 'projectId', 'charterId', 'perspective', 'type', 'title',
              'date', 'startTime', 'endTime', 'venue', 'chairperson', 'attendees', 'agenda',
              'minutes', 'decisions', 'actionItems', 'googleEventId', 'syncStatus',
              'lastSyncedAt', 'updatedAt'
            ]))
        );

      allow delete: if isVerified() && isValidId(meetingId) && (isOwner(existing().ownerId) || isAdmin());
    }

    // =========================================================================
    // /bscGovernanceConfig/{configId} — Escalation & Reminder Thresholds
    // =========================================================================
    match /bscGovernanceConfig/{configId} {
      allow get: if isValidId(configId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerified() &&
        isValidId(configId) &&
        configId == request.auth.uid &&
        incoming().ownerId == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().keys().hasAll([
          'ownerId', 'reminderDaysBeforeDue', 'escalationL1Days', 'escalationL2Days',
          'escalationL3Days', 'escalationL4Days', 'blockedEscalationDays',
          'followUpComplianceTarget', 'dailyDigestTime', 'dailyDigestTimezone', 'channels', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'ownerId', 'reminderDaysBeforeDue', 'escalationL1Days', 'escalationL2Days',
          'escalationL3Days', 'escalationL4Days', 'blockedEscalationDays',
          'followUpComplianceTarget', 'dailyDigestTime', 'dailyDigestTimezone', 'channels', 'updatedAt'
        ]) &&
        isValidBscGovernanceConfig(incoming());

      allow update: if isVerified() &&
        isValidId(configId) &&
        isValidBscGovernanceConfig(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().updatedAt == request.time &&
        (isOwner(existing().ownerId) || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'reminderDaysBeforeDue', 'escalationL1Days', 'escalationL2Days',
          'escalationL3Days', 'escalationL4Days', 'blockedEscalationDays',
          'followUpComplianceTarget', 'dailyDigestTime', 'dailyDigestTimezone', 'channels', 'updatedAt'
        ]);

      allow delete: if isVerified() && isValidId(configId) && isAdmin();
    }

    // =========================================================================
    // /calendarSyncLogs/{logId} — Append-Only Google Calendar Sync Audit Logs
    // =========================================================================
    match /calendarSyncLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerified() &&
        isValidId(logId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().keys().hasAll([
          'ownerId', 'entityType', 'entityId', 'entityCode', 'action',
          'status', 'message', 'actorName', 'syncedAt', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'ownerId', 'entityType', 'entityId', 'entityCode', 'googleEventId',
          'action', 'status', 'message', 'actorName', 'syncedAt', 'createdAt'
        ]) &&
        isValidCalendarSyncLog(incoming());

      allow update: if false;
      allow delete: if isVerified() && isValidId(logId) && isAdmin();
    }
  }
}
